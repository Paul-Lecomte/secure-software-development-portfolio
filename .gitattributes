# Normalise line endings to LF in the repository.
# This keeps HTML/CSS/JS/JSON output identical on Windows and Linux checkouts
# and stops CRLF/LF churn from producing noisy diffs.
* text=auto eol=lf

# Binary / non-text assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
